:root {
  color-scheme: dark;
  --bg: #070b14;
  --panel: #101a2b;
  --panel2: #16243a;
  --blue: #087bea;
  --cyan: #32d9ff;
  --text: #f4f8ff;
  --muted: #a8b6cc;
  --border: #293b56;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: radial-gradient(ellipse at top, #13294b, var(--bg) 65%);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

button, input {
  font: inherit;
}

button, a, input {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible, a:focus-visible, input:focus-visible {
  outline: 3px solid var(--cyan);
  outline-offset: 3px;
}

.hero {
  padding: 42px 18px 34px;
  text-align: center;
  border-bottom: 1px solid var(--border);
}

.eyebrow {
  color: var(--cyan);
  letter-spacing: 3px;
  font-size: .75rem;
  font-weight: bold;
}

h1 {
  margin: 8px 0;
  font-size: clamp(1.8rem, 6vw, 3.4rem);
  line-height: 1.2;
  overflow-wrap: anywhere;
}

h1 span {
  color: var(--cyan);
}

.hero p:last-child {
  color: var(--muted);
}

.container {
  width: min(1150px, 100%);
  margin: auto;
  padding: 24px 16px 40px;
}

label {
  display: block;
  margin-bottom: 8px;
  font-weight: bold;
}

.search {
  display: flex;
  gap: 8px;
}

.search input {
  flex: 1;
  min-width: 0;
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 13px;
}

button, .download {
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 11px 15px;
  background: var(--panel2);
  color: var(--text);
  cursor: pointer;
  text-align: center;
  text-decoration: none;
}

button:hover, .download:hover, button.active {
  background: var(--blue);
  border-color: var(--cyan);
}

.status, .note {
  color: var(--muted);
  font-size: .9rem;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 30px;
}

.tabs button {
  flex: 1 1 130px;
  min-height: 46px;
  font-weight: bold;
}

.catalog-section {
  margin: 30px 0;
  scroll-margin-top: 15px;
}

h2 {
  color: var(--cyan);
  font-size: 1.35rem;
  border-left: 4px solid var(--blue);
  padding-left: 12px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 245px), 1fr));
  gap: 16px;
}

.card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  background: linear-gradient(145deg, var(--panel2), var(--panel));
  border: 1px solid var(--border);
  border-radius: 13px;
  padding: 17px;
  overflow-wrap: anywhere;
}

.card:hover, .card:focus-within {
  border-color: var(--cyan);
}

.card h3 {
  margin: 0 0 8px;
  font-size: 1.05rem;
}

.card p {
  color: var(--muted);
  font-size: .9rem;
  flex: 1;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 10px 0 14px;
}

.badge {
  color: var(--cyan);
  background: #07334b;
  border-radius: 5px;
  padding: 3px 7px;
  font-size: .75rem;
}

.download {
  display: block;
  margin-top: 8px;
  background: var(--blue);
  font-weight: bold;
}

.empty {
  text-align: center;
  padding: 25px;
  color: var(--muted);
}

.top-button {
  display: block;
  margin: 25px auto 0;
}

footer {
  padding: 24px 16px;
  text-align: center;
  color: var(--muted);
  border-top: 1px solid var(--border);
  font-size: .85rem;
}

footer p {
  margin: 5px;
}

[hidden] {
  display: none !important;
}

@media (max-width: 480px) {
  .hero {
    padding-top: 30px;
  }

  .search {
    flex-direction: column;
  }

  .search button {
    min-height: 44px;
  }

  .container {
    padding-inline: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}